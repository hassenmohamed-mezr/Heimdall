# ============================================================
# Breast Cancer Assistant — example environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
# ============================================================

# ---- Backend (FastAPI) ----
APP_NAME=breast-cancer-assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/heimdall

# ---- Object / file storage ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---- LLM provider ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096

# ---- Model service (clinical + mammography) ----
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_API_KEY=change-me
WEIGHTS_DIR=./model_service/weights

# ---- Quotas / token budget ----
DAILY_REQUEST_LIMIT=50
MAX_TOKENS_PER_CONVERSATION=200000

# ---- Misc ----
LOG_LEVEL=INFO
